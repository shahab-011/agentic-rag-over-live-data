GROQ_API_KEY=
GROQ_MODEL=
GITHUB_TOKEN=
GITHUB_OWNER=langchain-ai
GITHUB_REPO=langgraph

# Create a Notion internal integration and share the pages it should access.
NOTION_API_KEY=

# Jira Cloud API token and Atlassian account details for the local Jira MCP server.
JIRA_URL=
JIRA_USERNAME=
JIRA_API_KEY=

# Local read-only Gmail MCP OAuth configuration.
# The first Gmail search opens a browser for read-only Google consent.
GMAIL_OAUTH_CLIENT_PATH=credentials/gmail-oauth-client.json
GMAIL_OAUTH_TOKEN_PATH=credentials/gmail-token.json
